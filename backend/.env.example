# App Configuration
APP_NAME="Cognitive GRC API"
DEBUG=true
ENVIRONMENT=development

# Security / Auth
# Secret keys for signing JWTs (should be changed in production)
JWT_SECRET_KEY=replace_this_with_a_secure_random_hex_key_for_development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_USER=grc_user
POSTGRES_PASSWORD=grc_password
POSTGRES_DB=cognitive_grc
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://grc_user:grc_password@db:5432/cognitive_grc

# Redis Configuration (Cache & Token/Rate Limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI Integration Configuration
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Security Configuration
# CRITICAL: Change ALL values below for production deployments!
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database (PostgreSQL)
# For docker-compose use host "db"; for local dev use "localhost".
DATABASE_URL=postgresql://grc_user:grc_password@db:5432/cognitive_grc

# Redis (cache, refresh-token store, rate limiting)
# For docker-compose use host "redis"; for local dev use "localhost".
REDIS_URL=redis://redis:6379/0

# CORS — comma-separated list of allowed origins (defaults to localhost dev servers)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "true" to expose /docs, /redoc and /openapi.json (development only)
ENABLE_DOCS=false

# ADMIN_PASSWORD is used by create_initial_user.py
ADMIN_PASSWORD=
